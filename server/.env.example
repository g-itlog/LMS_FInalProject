PORT=8000
# Use MongoDB Atlas or a local replica set; signup and password reset use transactions.
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DB_NAME=classroom_lms
JWT_SECRET=replace-with-at-least-32-random-characters
INSTRUCTOR_INVITE_CODE=replace-with-a-private-instructor-code
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000
NODE_ENV=development
# Vercel: set database/auth secrets in the dashboard, NODE_ENV=production,
# and CLIENT_ORIGINS=https://YOUR-PRODUCTION-DOMAIN (no trailing slash).
# Vercel-provided production/preview origins are also recognized automatically.
# Optional; required only when seeding. Choose your own strong value.
DEMO_PASSWORD=ReplaceWithYourOwnStrongPassword2026!

# Required for public registration verification and Forgot password.
# Gmail example: SMTP_HOST=smtp.gmail.com; SMTP_USER=your sending Gmail address;
# SMTP_PASS=a Google App Password (not the account's normal password).
# For another provider, use its documented SMTP host, credentials, and verified sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# STARTTLS is required when SMTP_SECURE=false. Use true with port 465.
