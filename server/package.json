{
  "name": "knowhere-to-grow-api",
  "version": "1.0.0",
  "description": "Secure MERN learning management API",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "mail:check": "node scripts/check-mail.js",
    "server": "node server.js",
    "dev": "node --watch index.js",
    "dev:all": "node scripts/dev.js",
    "docs:build": "node scripts/build-docs.js && node scripts/build-presentation.js",
    "package:source": "node scripts/package-source.js",
    "package:mobile": "node scripts/package-source.js --mobile",
    "start": "node index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "seed": "node scripts/seed.js",
    "seed:courses": "node scripts/seed-courses.js",
    "admin:create": "node scripts/create-admin.js",
    "test:serve": "node scripts/test-server.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
