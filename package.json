{
  "name": "knowhere-to-grow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "mail:check": "npm --prefix server run mail:check",
    "server": "npm --prefix server run server",
    "setup": "npm --prefix server ci && npm --prefix client ci",
    "dev": "node server/scripts/dev.js",
    "docs": "npm --prefix server run docs:build",
    "package:source": "npm --prefix server run package:source",
    "build": "npm run deploy:check && npm --prefix client run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test",
    "seed": "npm --prefix server run seed",
    "seed:courses": "npm --prefix server run seed:courses",
    "admin:create": "npm --prefix server run admin:create --",
    "test:e2e": "npm --prefix client run test:e2e",
    "deploy:check": "node server/scripts/check-vercel.js"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
